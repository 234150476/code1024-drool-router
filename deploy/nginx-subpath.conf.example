# Add inside the existing HTTPS server for api.code1024.cc.
# Build the frontend with DROOL_BASE=/quality/.
location = /quality {
    access_log off;
    error_log /var/log/nginx/quality.error.log crit;
    return 308 /quality/$is_args$args;
}

location ^~ /quality/ {
    # Do not record the initial embedded administrator session query.
    access_log off;
    error_log /var/log/nginx/quality.error.log crit;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $remote_addr;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 10s;
    proxy_send_timeout 600s;
    proxy_read_timeout 600s;
    proxy_buffering off;
    proxy_request_buffering off;
    proxy_cache off;
    # Trailing slash removes /quality/ before forwarding to Python.
    proxy_pass http://127.0.0.1:4191/;
}
